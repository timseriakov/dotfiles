{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mcpproxy": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp"
    },
    "pencil": {
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  }
}