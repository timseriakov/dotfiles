#!/usr/bin/env python3
"""Set the macOS default browser and verify both URL scheme handlers."""
import os
import plistlib
import subprocess
import sys
import time

DOMAIN = "com.apple.LaunchServices/com.apple.launchservices.secure"
SCHEMES = ("http", "https")


def main():
    if len(sys.argv) != 2:
        sys.exit(f"Usage: {sys.argv[0]} <bundle-id>")
    bundle_id = sys.argv[1]
    data = plistlib.loads(subprocess.check_output(["defaults", "export", DOMAIN, "-"]))
    handlers = [
        h for h in data.get("LSHandlers", [])
        if h.get("LSHandlerURLScheme") not in SCHEMES
    ]
    handlers.extend(
        {"LSHandlerURLScheme": scheme, "LSHandlerRoleAll": bundle_id}
        for scheme in SCHEMES
    )
    data["LSHandlers"] = handlers
    # Go through cfprefsd so its cached preferences cannot overwrite our change.
    subprocess.run(
        ["defaults", "import", DOMAIN, "-"], input=plistlib.dumps(data), check=True
    )
    subprocess.run(["killall", "-u", str(os.getuid()), "lsd"], capture_output=True)
    for _ in range(30):
        if all(
            subprocess.check_output(["duti", "-d", scheme], text=True).strip().lower()
            == bundle_id.lower()
            for scheme in SCHEMES
        ):
            print(f"Default browser → {bundle_id}")
            return
        time.sleep(0.1)
    sys.exit(f"Failed to apply default browser: {bundle_id}")


if __name__ == "__main__":
    main()
