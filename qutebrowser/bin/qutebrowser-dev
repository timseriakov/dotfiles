#!/usr/bin/env bash
set -euo pipefail

export QUTE_DEV_PROFILE=1
export QUTE_AGENT_BROWSER=1
DEV_BASE="$HOME/.local/share/qutebrowser-dev"

mkdir -p "$DEV_BASE"

if [[ $# -eq 0 ]]; then
  set -- about:blank
fi

exec qutebrowser \
  --basedir "$DEV_BASE" \
  --config-py "$HOME/dev/dotfiles/qutebrowser/config.py" \
  --target window \
  "$@"
