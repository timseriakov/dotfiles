#!/bin/bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

if [[ -z "${QUTE_FIFO:-}" || ! -p "$QUTE_FIFO" ]]; then
  echo "Error: Must be run as qutebrowser userscript (QUTE_FIFO not set)" >&2
  exit 1
fi

state_dir="${QUTE_DATA_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/qutebrowser}"
state_file="$state_dir/tabs-status-hidden"
mkdir -p "$state_dir"

hidden=0
[[ -r "$state_file" ]] && read -r hidden <"$state_file"

if [[ "$hidden" == "1" ]]; then
  echo "set statusbar.show always" >> "$QUTE_FIFO"
  echo "set tabs.show multiple" >> "$QUTE_FIFO"
  echo 0 > "$state_file"
else
  echo "set statusbar.show in-mode" >> "$QUTE_FIFO"
  echo "set tabs.show never" >> "$QUTE_FIFO"
  echo 1 > "$state_file"
fi
