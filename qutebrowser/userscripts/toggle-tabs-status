#!/bin/bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

if [[ -z "${QUTE_FIFO:-}" || ! -p "$QUTE_FIFO" ]]; then
  echo "Error: Must be run as qutebrowser userscript (QUTE_FIFO not set)" >&2
  exit 1
fi

state_dir="${QUTE_DATA_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/qutebrowser}"
state_file="$state_dir/tabs-status-hidden"
mkdir -p "$state_dir"

if [[ ! -f "$state_file" ]]; then
  # First run: unconditionally hide both
  {
    echo "set statusbar.show in-mode"
    echo "set tabs.show never"
  } >> "$QUTE_FIFO"
  printf 0 > "$state_file"
elif [[ "$(cat "$state_file")" == "0" ]]; then
  # Hidden → show both
  {
    echo "set statusbar.show always"
    echo "set tabs.show multiple"
  } >> "$QUTE_FIFO"
  printf 1 > "$state_file"
else
  # Shown → hide both
  {
    echo "set statusbar.show in-mode"
    echo "set tabs.show never"
  } >> "$QUTE_FIFO"
  printf 0 > "$state_file"
fi
